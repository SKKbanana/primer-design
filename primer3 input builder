s-visible{outline:3px solid #87b9a7;outline-offset:3px}button:disabled{opacity:.5;cursor:default}.primary,.secondary,.small-button{padding:12px 16px;border-radius:9px;border:1px solid transparent;font-size:13px}.primary{background:var(--green);color:white}.primary:hover:not(:disabled){background:#124d3d}.secondary{background:#fff;border-color:#cfdbd1;color:#315441}.secondary:hover{background:#f1f6ef}.small-button{padding:7px 10px;background:var(--light);color:var(--green)}.text-button{background:none;border:none;color:var(--green);font-size:12px;cursor:pointer;font-weight:500;padding:0}.section-title .text-button{margin-left:auto}.generate{width:100%;padding:16px 20px;display:flex;justify-content:center;gap:24px;align-items:center;font-size:15px}.inset{margin-top:20px;background:#f5f8f3;padding:16px;border:1px solid #e0e9dc;border-radius:9px}.inset>.hint{margin-bottom:12px}.spaced{margin-top:20px}details{border-top:1px solid var(--line);margin-top:18px;padding-top:15px}summary{font-size:12px;font-weight:550;cursor:pointer;line-height:1.7;color:#3b6350}summary span{float:right}.advanced-body{padding-top:22px}.subhead{display:flex;justify-content:space-between;gap:12px;margin-bottom:14px}.subhead h3{margin:0}.output-card{border-radius:17px;background:#fff;border:1px solid #d7e2d9;overflow:hidden;margin-bottom:18px;box-shadow:0 8px 30px #28463106}.output-heading{padding:23px 23px 19px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.output-heading .eyebrow{margin-bottom:6px}.status{border:1px solid #dfe7df;border-radius:20px;padding:4px 9px;font-size:11px;color:#7f8c83}.status.ready{background:var(--light);color:var(--green);border-color:#c9e2d0}#emptyOutput{text-align:center;padding:95px 20px 100px;color:#829187}#emptyOutput h3{font-size:15px;color:#536b5c}#emptyOutput p{font-size:12px;line-height:1.9}.empty-icon{font:30px var(--mono);color:#91ae9c;margin-bottom:28px}.output-footer{padding:14px 22px;color:#829187;background:#fafcf9;border-top:1px solid #e8eee7;font-size:10px;display:flex;align-items:center;gap:7px}.result-stats{display:grid;grid-template-columns:1fr 1fr 1.2fr;gap:12px;padding:21px 23px 16px}.result-stats span{font-size:11px;color:var(--muted);display:block;margin-bottom:4px}.result-stats strong{font-size:16px;font-weight:550;font-family:var(--mono)}.region-track{height:7px;background:#e9eee8;border-radius:9px;position:relative;margin:0 23px}.region-track div{position:absolute;top:0;height:100%;min-width:2px;background:#60a17d;border-radius:9px}.output-note{font-size:11px;color:var(--muted);margin:9px 23px 18px}#output{background:#142c23;color:#d8e9da;border-radius:0;border:none;resize:vertical;padding:20px 23px;font:11px/1.9 var(--mono);height:445px;min-height:200px;white-space:pre;overflow:auto;margin:0;tab-size:2}#output:focus{box-shadow:inset 0 0 0 2px #75b293}.output-buttons{display:flex;gap:10px;padding:18px 23px 0}.output-buttons button:first-child{flex:1}.output-buttons button:last-child{min-width:100px}#copyStatus{min-height:17px;margin-bottom:13px;margin-top:7px}.guide h3{font-size:14px}.guide p{font-size:12px;color:var(--muted);line-height:1.8;margin:10px 0 17px}.guide select{font-size:12px}.guide pre{white-space:pre-wrap;word-break:break-all;background:#f0f4ee;border-radius:7px;padding:13px;font:11px/1.9 var(--mono);color:#3b5a43;margin:12px 0}.guide details p:last-child{margin-bottom:0}.guide code,footer code{font-size:11px;overflow-wrap:anywhere}.warnings{background:#fffcf0;border-color:#e9dfb9}.warnings h3{color:#7b6928}.warnings ul{padding-left:18px;font-size:12px;color:#82713f;margin:0}.warnings li+li{margin-top:7px}#errorBox{background:#fff2ef;border:1px solid #e8bfb4;color:#943a29;border-radius:9px;margin:0 0 16px;padding:14px 17px;font-size:13px}footer{font-size:11px;color:#7f8c81;text-align:center;padding:35px 0 0}footer a{color:#547c62;text-decoration:none}footer p{margin:8px 0 0;line-height:1.8}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}.mobile-only{display:none}@media(min-width:1200px){aside{position:sticky;top:22px}}@media(max-width:950px){main{padding:30px 22px}.workspace{gap:18px;grid-template-columns:1fr 1fr}.card{padding:18px}h1{font-size:29px}.intro .secondary{white-space:nowrap}.section-title{gap:7px}.section-title h2{font-size:16px}.row,.triple{gap:10px}.sequence-meta span:last-child{display:none}}@media(max-width:760px){.workspace{grid-template-columns:1fr}.topbar{height:64px;padding:0 18px}.brand{font-size:14px;gap:8px}.offline{font-size:10px}.intro{align-items:flex-start;margin-bottom:25px;gap:12px}.intro .secondary{font-size:11px;padding:9px}h1{font-size:28px}.mobile-only{display:block}main{padding:29px 16px}.intro>div>p:last-child{font-size:12px}.eyebrow{font-size:9px;letter-spacing:1.5px}.card{padding:18px;border-radius:12px}#emptyOutput{padding:60px 20px}.row{gap:12px}.triple{gap:8px}input:not([type=checkbox]),select,textarea{font-size:16px}.hint{font-size:11px}.subhead .text-button{font-size:11px}.unit{font-size:10px}.section-title .text-button{font-size:11px}.target-heading{gap:5px}.segmented button{font-size:11px;padding:5px 9px}.result-stats strong{font-size:14px}label{font-size:12px}.output-footer{font-size:9px}}@media print{.topbar,.intro,form,.output-buttons,.guide,footer{display:none}.workspace{display:block}main{padding:0}.output-card{border:0;box-shadow:none}#output{height:auto;color:#000;background:#fff}}
