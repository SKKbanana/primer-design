    $('warnings').replaceChildren();for(const w of r.warnings){const li=document.createElement('li');li.textContent=w;$('warnings').append(li);}$('warningsCard').hidden=!r.warnings.length;command();
  }
  $('form').addEventListener('submit',e=>{e.preventDefault();hideError();try{const r=B.generate(config());if(targetMode==='sequence')renderMatches(r.target.matches,r.target.key);render(r);if(window.innerWidth<761)$('outputStatus').scrollIntoView({behavior:'smooth',block:'center'});}catch(err){invalidate();if(err.matches?.length)renderMatches(err.matches);showError(err);}});
  $('form').addEventListener('input',e=>{invalidate();if(['template','targetSequence','searchReverse'].includes(e.target.id))clearMatch();if(e.target.id==='template')updateStats();if(e.target.id==='mode')$('modeHint').textContent=modeHints[$('mode').value];});
  $('form').addEventListener('change',e=>{if(e.target.id==='profile')profileChanged();if(e.target.id==='mode')$('modeHint').textContent=modeHints[$('mode').value];});
  $('posTab').addEventListener('click',()=>setTargetMode('positions'));$('seqTab').addEventListener('click',()=>setTargetMode('sequence'));$('locateBtn').addEventListener('click',locate);
  $('resetParamsBtn').addEventListener('click',()=>{resetParams();invalidate();});$('terminal').addEventListener('change',command);
  $('importBtn').addEventListener('click',()=>$('fileInput').click());
  $('fileInput').addEventListener('change',async e=>{
    const file=e.target.files[0];if(!file)return;invalidate();
    try {if(file.size>2*1024*1024)throw new Error('文件超过 2 MB，请缩小序列范围后导入。');const text=await file.text();B.normalize(text);$('template').value=text;clearMatch();updateStats();if(!$('id').value){const stem=file.name.replace(/\.[^.]+$/,'').replace(/[^A-Za-z0-9_.-]/g,'_').replace(/^[^A-Za-z0-9]+/,'').slice(0,80);$('id').value=stem||'sequence_1';}}
    catch(err){showError(err);}finally{e.target.value='';}
  });
  $('downloadBtn').addEventListener('click',()=>{if(!result)return;const blob=new Blob([result.text],{type:'text/plain;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=result.filename;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);$('copyStatus').textContent='已触发下载：'+result.filename;});
  $('copyBtn').addEventListener('click',async()=>{if(!result)return;try{if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(result.text);}else{ $('output').focus();$('output').select();if(!document.execCommand('copy'))throw new Error('copy');}$('copyStatus').textContent='指令已复制。';}catch{ $('output').focus();$('output').select();$('copyStatus').textContent='请按 Ctrl+C（Mac：⌘C）复制已选中的指令。';}});
  $('exampleBtn').addEventListener('click',()=>{
    // Synthetic example only. Never a biological reference or assay recommendation.
    let seed=230924,sequence='';for(let i=0;i<1200;i++){seed=(Math.imul(seed,1664525)+1013904223)>>>0;sequence+='ACGT'[seed>>>30];}
    $('form').reset();$('profile').value='pcr';profileChanged();setTargetMode('positions');$('id').value='synthetic_demo';$('template').value='>synthetic_demo | artificial DNA for software demonstration only\n'+sequence.match(/.{1,80}/g).join('\n');$('start').value=401;$('end').value=650;clearMatch();updateStats();$('form').requestSubmit();
  });
  profileChanged();updateStats();
})();
</script>
</body></html>
