<title>Primer3 输入文件生成器</title>
<style>:root{--green:#186650;--light:#eaf4ee;--ink:#1a3029;--muted:#6b7d75;--line:#dfe7e1;--paper:#f5f7f3;--mono:Consolas,"SFMono-Regular",monospace}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI","Microsoft YaHei",sans-serif;font-size:14px;line-height:1.6}.topbar{height:76px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;padding:0 max(4vw,24px);background:#fff}.brand{display:flex;align-items:center;gap:12px;font-size:16px;font-weight:650}.brandmark{background:var(--green);color:#fff;padding:6px 9px;border-radius:9px;font:700 17px var(--mono)}.offline{font-size:12px;color:var(--muted);display:flex;gap:7px;align-items:center}.offline i,.dot{display:inline-block;background:#58a47c;height:6px;width:6px;border-radius:50%}main{max-width:1380px;margin:auto;padding:42px 38px 22px}.intro{display:flex;align-items:center;justify-content:space-between;gap:24px;margin-bottom:34px}.eyebrow{font:600 11px var(--mono);letter-spacing:2px;color:var(--green);margin:0 0 12px}h1{font-size:34px;letter-spacing:-.9px;line-height:1.35;margin:0 0 12px;font-weight:650}.intro>div>p:last-child{color:var(--muted);font-size:15px;margin:0}.workspace{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:28px;align-items:start}form,aside{min-width:0}.card{border:1px solid var(--line);border-radius:16px;background:#fff;padding:23px;margin-bottom:18px}.section-title{display:flex;align-items:center;gap:10px;margin-bottom:21px}.step{font:600 12px var(--mono);color:var(--green);padding:5px 7px;background:var(--light);border-radius:5px}h2{font-size:17px;margin:0;font-weight:650}h3{font-size:14px;margin:0 0 12px;font-weight:650}.minor{margin-left:auto;color:#7b8b82;font-size:12px}.optional,.unit{font-size:11px;color:var(--muted);font-weight:400;margin-left:5px}.row,.triple{display:grid;gap:16px;margin-bottom:15px}.row{grid-template-columns:1fr 1fr}.